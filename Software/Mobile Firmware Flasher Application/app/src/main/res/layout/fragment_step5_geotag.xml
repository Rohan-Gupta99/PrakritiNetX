<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Critical Notice Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_warning"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIELD DEPLOYMENT PROTOCOL"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/geotag_instruction"
                android:textColor="#212121"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- GPS Coordinates Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GPS GEOLOCATION FIX"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pbGps"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGpsCoordinates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Coordinates: Not Acquired\nAccuracy: --\nAltitude: --"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAcquireGps"
                style="@style/FieldButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="ACQUIRE HIGH-ACCURACY GPS FIX" />
        </LinearLayout>

        <!-- Node Identification Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENSOR NODE RECORD METADATA"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNodeMetadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Hardware Node ID: --\nFirmware Version: --\nTarget Silicon: --"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Optional On-Board Writeback Toggle -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchWriteToBoard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="@string/toggle_write_to_node"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Technician Notes Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Technician Site Notes (e.g. Alaknanda River Pillar #4)"
                android:textColorHint="@color/text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSiteNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Result Confirmation Banner -->
        <TextView
            android:id="@+id/tvGeotagFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_rounded"
            android:padding="12dp"
            android:textColor="@color/status_success"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnConfirmDeployment"
            style="@style/FieldButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/btn_confirm_location" />

        <Button
            android:id="@+id/btnFinish"
            style="@style/FieldButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="DONE / FLASH ANOTHER NODE"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

